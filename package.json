{
  "name": "winpulse-sentinel",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:build:nsis": "tauri build --bundles nsis",
    "tauri:build:msi": "tauri build --bundles msi",
    "tauri:build:all": "tauri build --bundles nsis,msi",
    "build:wasm": "wasm-pack build crates/sentinel-wasm --target web --out-dir ../../src/wasm/pkg --release",
    "test:wasm": "bun test src/wasm",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.28",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-notification": "^2.8.1",
    "lucide-react": "^1.80.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.6",
    "@types/bun": "^1.4.5",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "wasm-pack": "^0.15.1"
  },
  "trustedDependencies": [
    "wasm-pack"
  ]
}
