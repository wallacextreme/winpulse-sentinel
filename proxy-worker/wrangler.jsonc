{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "winpulse-ai-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-01",
  "workers_dev": true,
  "preview_urls": false,
  "ratelimits": [
    {
      "name": "DIAGNOSE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 6,
        "period": 60
      }
    }
  ]
}
